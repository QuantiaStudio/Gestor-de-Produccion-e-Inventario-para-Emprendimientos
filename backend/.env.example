DEBUG=True
SECRET_KEY=django-insecure-CHANGE-ME
ALLOWED_HOSTS=localhost,127.0.0.1

# Datos de conexión a MySQL.
# - Si usás el docker-compose incluido (MySQL solo para la DB), dejá estos valores.
# - Si usás un MySQL local propio, cambiá HOST/PORT/USER/PASSWORD/NAME según tu instalación
#   y creá manualmente esa base y usuario en tu servidor local.
DB_NAME=quantia_db
DB_USER=quantiauser
DB_PASSWORD=djangopassword
DB_ROOT_PASSWORD=rootpassword
DB_HOST=127.0.0.1
DB_PORT=3306
